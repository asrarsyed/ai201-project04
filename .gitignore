# API keys — never commit these
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Hugging Face model cache
.cache/
models/

# OS noise
.DS_Store
Thumbs.db

# Runtime data — generated at runtime, not shipped. Structure documented
# in docs/ARCHITECTURE.md; sample findings from these are quoted directly
# in docs/RESEARCH.md instead of keeping the raw files tracked.
# The .gitkeep files are re-included so a fresh clone still has the
# directories the service and scripts write into.
logs/*
results/*
!logs/.gitkeep
!results/.gitkeep

# build artifacts
build/
dist/
*.egg-info/
